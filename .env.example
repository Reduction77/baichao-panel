# 必须改为你实际配置 HTTPS 的管理域名；不能填写公开 Wiki 域名。
PANEL_PUBLIC_URL=https://panel.example.com
PANEL_ADMIN_USER=admin
# 使用 docker compose run --rm panel python -m server.manage hash-password 生成。
PANEL_PASSWORD_HASH=CHANGE_ME
# 只授权 Wiki 仓库，不需要授权管理工具仓库。
PANEL_GITHUB_REPO=Reduction77/baichao-wiki
PANEL_GITHUB_BRANCH=main
PANEL_GITHUB_TOKEN=
